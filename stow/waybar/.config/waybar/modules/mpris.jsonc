{
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "rotate": 0,                                      // ← cambiado a número fijo
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": { 
            "default": "▶",
            "mpv": "♪"
        },
        "status-icons": {
            "paused": "Pause"
        },
        // "ignored-players": ["firefox"],
        "max-length": 1000,
        "interval": 1
    }
}